# Copy this file to .env and fill your values

# PostgreSQL 16 (local)
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/gym_admin

# Long random string for session cookies
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# First admin login (created automatically if admins table is empty)
ADMIN_NAME=Owner
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123

GYM_NAME=Gravity Fitness Club
# Printed on receipts (leave empty to hide)
GYM_ADDRESS=
GYM_PHONE=
REMINDER_DAYS=2

# true only when the site runs on https (live server); false on your PC
COOKIE_SECURE=false
